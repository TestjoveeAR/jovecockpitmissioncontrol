# --- LOCAL DEV (laptop) --------------------------------------------------
# For local development, point DATABASE_URL at a Neon Postgres branch (free)
# or a local Postgres instance.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Where the Neural Map reads notes from.
#   filesystem  → reads .md files from VAULT_PATH on disk (laptop only)
#   github      → reads from a private GitHub repo (production)
VAULT_SOURCE="filesystem"
VAULT_PATH="D:/Downloads/Jovee/Jovee Vault"

# --- VAULT-OVER-GITHUB (production) --------------------------------------
# Only used when VAULT_SOURCE=github. Create a "Fine-grained" personal access
# token at https://github.com/settings/tokens/?type=beta with READ-ONLY access
# to your private vault repo (Contents + Metadata scopes).
GITHUB_VAULT_REPO=""        # e.g. "BobTa/jovee-vault"
GITHUB_VAULT_BRANCH="main"
GITHUB_TOKEN=""             # GitHub PAT, starts with github_pat_...

# --- TEAM PASSWORD GATE (production only) --------------------------------
# Set this on Vercel to lock the cockpit behind a single shared password.
# Leave blank locally so you don't have to log in during dev.
COCKPIT_PASSWORD=""

# --- OPTIONAL INTEGRATIONS -----------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=""
TRELLO_API_KEY=""
TRELLO_API_TOKEN=""
ANTHROPIC_API_KEY=""
